{
  "name": "opencode-websearch",
  "version": "1.0.1",
  "description": "Web search plugin for OpenCode",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    }
  },
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun run --watch src/index.ts",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "lint": "oxlint --tsconfig tsconfig.json src/",
    "lint:fix": "oxlint --tsconfig tsconfig.json --fix src/",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepublishOnly": "bun run check && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "web-search",
    "anthropic",
    "openai",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dylan-Liew/opencode-websearch.git"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "openai": "^6.22.0",
    "@opencode/plugin": "2.0.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "typescript": "^5.8.0"
  }
}
